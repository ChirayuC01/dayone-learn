# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://dayone:dayone@localhost:5432/dayone?schema=public"

# ── App ──────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ── Auth.js (phase 3) ────────────────────────────────────
# openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=""
# Required behind a proxy such as Azure App Service (not needed for `next dev`)
AUTH_TRUST_HOST="true"
# Comma-separated emails that get the ADMIN role on sign-in
ADMIN_EMAILS=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Email via Resend (magic links, reminders) ────────────
# Leave empty in development: sign-in links are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="DayOne <learn@example.com>"

# ── Machine-to-machine secrets ───────────────────────────
# Bearer token for the content ingest API (one per deployment)
INGEST_TOKEN=""
# Bearer token for the cron route handlers
CRON_SECRET=""
